{
  "name": "rhythmx",
  "version": "0.0.13",
  "description": "The Rhythm CLI: scaffold and manage Rhythm projects from the command line, running on Bun.",
  "homepage": "https://rhythm.js.org",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/rhythmx"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "rhythm": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --outdir dist --root src --format esm --target bun --packages external",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@rhythmjs/cli": "workspace:*",
    "@rhythmjs/rhythm": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
