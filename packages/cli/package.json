{
  "name": "@rhythmjs/cli",
  "version": "0.0.1",
  "description": "Command-line argument parsing, prompts, and command routing for the Rhythm middleware kernel.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rhythm-cli.d.ts",
      "default": "./dist/rhythm-cli.js"
    },
    "./argv": {
      "types": "./dist/argv.d.ts",
      "default": "./dist/argv.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "default": "./dist/adapters/deno.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/context": {
      "types": "./dist/adapters/context.d.ts",
      "default": "./dist/adapters/context.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rhythmjs/rhythm": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
