{
  "name": "@rhythmjs/rhythm",
  "version": "0.0.21",
  "description": "A minimal, type-safe middleware and startup-composition kernel: register() at startup, use() per request, with derive, decorate, mount and include.",
  "homepage": "https://rhythm.js.org/rhythm",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/rhythm"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rhythm.d.ts",
      "default": "./dist/rhythm.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./derive": {
      "types": "./dist/derive.d.ts",
      "default": "./dist/derive.js"
    },
    "./decorate": {
      "types": "./dist/decorate.d.ts",
      "default": "./dist/decorate.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./include": {
      "types": "./dist/include.d.ts",
      "default": "./dist/include.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "build": "bun build src/rhythm.ts src/compose.ts src/pipeline.ts src/derive.ts src/decorate.ts src/mount.ts src/include.ts src/source.ts src/types.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
