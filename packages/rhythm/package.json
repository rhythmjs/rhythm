{
  "name": "@rhythmjs/rhythm",
  "version": "0.0.5",
  "description": "A minimal, type-safe onion-middleware and provider composition kernel.",
  "homepage": "https://rhythm.js.org/rhythm",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/rhythm"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rhythm.d.ts",
      "default": "./dist/rhythm.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
