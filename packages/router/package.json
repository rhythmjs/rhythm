{
  "name": "@rhythmjs/router",
  "version": "0.0.9",
  "description": "HTTP router for the Rhythm middleware kernel, matching with rou3, with Bun, Node, and Deno adapters.",
  "homepage": "https://rhythm.js.org/router",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rhythm-router.d.ts",
      "default": "./dist/rhythm-router.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "default": "./dist/adapters/deno.js"
    },
    "./adapters/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "default": "./dist/adapters/vercel.js"
    },
    "./adapters/netlify": {
      "types": "./dist/adapters/netlify.d.ts",
      "default": "./dist/adapters/netlify.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    },
    "./adapters/aws-lambda": {
      "types": "./dist/adapters/aws-lambda.d.ts",
      "default": "./dist/adapters/aws-lambda.js"
    },
    "./adapters/service-worker": {
      "types": "./dist/adapters/service-worker.d.ts",
      "default": "./dist/adapters/service-worker.js"
    },
    "./adapters/context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rhythmjs/rhythm": "workspace:*",
    "rou3": "^0.11.0",
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
