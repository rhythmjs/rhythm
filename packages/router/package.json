{
  "name": "@rhythmjs/router",
  "version": "0.0.5",
  "description": "Radix-tree HTTP router for the Rhythm middleware kernel, with Bun, Node, and Deno adapters.",
  "homepage": "https://rhythm.js.org/router",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git",
    "directory": "packages/router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/rhythm-router.d.ts",
      "default": "./dist/rhythm-router.js"
    },
    "./radix-tree": {
      "types": "./dist/radix-tree.d.ts",
      "default": "./dist/radix-tree.js"
    },
    "./adapters/web-std": {
      "types": "./dist/adapters/web-std.d.ts",
      "default": "./dist/adapters/web-std.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "default": "./dist/adapters/deno.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/context": {
      "types": "./dist/adapters/context.d.ts",
      "default": "./dist/adapters/context.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rhythmjs/rhythm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
