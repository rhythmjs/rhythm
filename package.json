{
  "name": "rhythmjs",
  "version": "0.0.12",
  "private": true,
  "description": "A minimal, type-safe onion-middleware and provider composition kernel. Bun workspaces, bun test, bun build.",
  "keywords": [],
  "homepage": "https://rhythm.js.org",
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/rhythm.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run --filter '@rhythmjs/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint packages/*/src examples/*/src",
    "fmt": "prettier --write \"packages/*/src/**/*.ts\" \"examples/*/src/**/*.ts\" \"packages/*/*.json\" \"examples/*/*.json\" \"*.json\"",
    "fmt:check": "prettier --check \"packages/*/src/**/*.ts\" \"examples/*/src/**/*.ts\" \"packages/*/*.json\" \"examples/*/*.json\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
